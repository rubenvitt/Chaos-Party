{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM nur für die Typen der mitgebündelten Host-Module (apps/host); das Bündel selbst nutzt
    // keine DOM-APIs (JavaScriptCore hat keine).
    "lib": ["ES2023", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["src", "test", "build.mjs", "scripts"]
}
