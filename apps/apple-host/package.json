  "private": true,
  "description": "Nativer Host für Mac und Apple TV (ADR-019): JS-Kern (Session-Server, game-core, Host-Rolle, Minispiele headless) als Bündel für JavaScriptCore und die Swift-App, die ihn ausführt.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "bots": "node scripts/bot-match.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0",
    "@babylonjs/havok": "^1.3.14",
    "@chaos-party/game-core": "workspace:*",
    "@chaos-party/minigame-sdk": "workspace:*",
    "@chaos-party/minigames": "workspace:*",
    "@chaos-party/protocol": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2"
  }
}
