{
  "name": "@chaos-party/server",
  "version": "0.0.0",
  "private": true,
  "description": "Lokaler Session-Server auf dem PC: liefert die Controller-App aus und (ab CHAOS-9) die WebSocket-Verbindung.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@chaos-party/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
